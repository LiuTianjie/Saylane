    "AI 已检查，无需修改": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI checked it; no changes needed"
          }
        }
      }
    },
    "AI 改动过大 · 已保留本地结果": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI changed too much · kept the local result"
          }
        }
      }
    },
    "AI 改动过大，已保留本地结果。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI rewrote too much; the local result was kept."
          }
        }
      }
    },
    "AI 润色中": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI proofreading"
          }
        }
      }
    },
    "AI 润色失败 · 已保留普通结果": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI proofreading failed · kept the plain result"
          }
        }
      }
    },
    "AI 润色未完成，已保留普通结果；请检查模型配置或网络。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI proofreading did not finish; the plain result was kept. Check the model settings or your network."
          }
        }
      }
    },
    "AI 润色超时 · 已保留普通结果": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI proofreading timed out · kept the plain result"
