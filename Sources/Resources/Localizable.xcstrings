            "state": "translated",
            "value": "librime failed to initialize"
          }
        }
      }
    },
    "macOS 自带，不用下载 · 100 个字错 5 个": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built into macOS, nothing to download · 5 characters in 100 wrong"
          }
        }
      }
    },
    "zh/z、an/ang 等，精确音节优先": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "zh/z, an/ang and similar; exact syllables rank first"
          }
        }
      }
    },
    "上一次听写已复制到剪贴板。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last dictation is on the clipboard."
          }
