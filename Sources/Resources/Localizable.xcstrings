{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "%@ → %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@"
          }
        }
      }
    },
    "%@ 不支持这种语言": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ does not support this language"
          }
        }
      }
    },
    "%@ 已就绪": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ready"
          }
        }
      }
    },
    "%@ 已就绪：系统识别实时出字，它写终稿": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ready: the system recognizer shows the words, it writes the final text"
          }
        }
      }
    },
    "%@ 是系统保留组合，不能绑定。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is reserved by the system and cannot be bound."
          }
        }
      }
    },
    "%@ 没有加载成功；现在写系统识别听到的": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ could not be loaded; the system recognizer's text is written for now"
          }
        }
      }
    },
    "%@ 语音模型已安装": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ speech model installed"
          }
        }
      }
    },
    "%@，我说%@，写成%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, I speak %@, write %@"
          }
        }
      }
    },
    "%@：我说 %@ → 写成 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: I speak %@ → write %@"
          }
        }
      }
    },
