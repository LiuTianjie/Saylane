          }
        }
      }
    },
    "语音模型清单缺失或无效，请重新安装应用。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The speech model manifest is missing or invalid. Reinstall the app."
