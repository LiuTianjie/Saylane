          }
        }
      }
    },
    "点按 %@，说完按任意键提交。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap %@, then press any key to insert when you finish."
          }
        }
      }
    },
    "点按开始": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to start"
          }
        }
      }
    },
    "点按开始，再按任意键提交": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to start, press any key to insert"
          }
        }
      }
    },
    "点这里，说说你今天的计划…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click here and tell me about your plans for today…"
          }
        }
      }
    },
    "用 ; 和 ' 选第 2、第 3 个候选": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the 2nd and 3rd candidate with ; and '"
          }
        }
      }
    },
    "登录时启动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start at login"
          }
        }
      }
    },
    "磁盘空间不足，请腾出足够空间后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough disk space. Free some space and try again."
          }
        }
      }
    },
    "移到窗口上或拖动划选": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hover over a window or drag to select"
          }
