    },
    "Tab 切换原文 / 译文，⌘C 复制，D 换方向，Esc 关闭；可拖动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab toggles original / translation, ⌘C copies, D changes direction, Esc closes; draggable"
          }
        }
      }
    },
