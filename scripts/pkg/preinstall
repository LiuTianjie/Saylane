#!/bin/bash
set -euo pipefail
export TZ=Asia/Shanghai
# Remove only this product; preserve user preferences and every other input method.
stop_process() {
  local name="$1"
  /usr/bin/pkill -TERM -x "$name" 2>/dev/null || true
  for _ in {1..50}; do
    /usr/bin/pgrep -x "$name" >/dev/null 2>&1 || return 0
    /bin/sleep 0.1
  done
  /usr/bin/pkill -KILL -x "$name" 2>/dev/null || true
  /usr/bin/pgrep -x "$name" >/dev/null 2>&1 && {
    echo "Could not stop $name before upgrade." >&2
    exit 1
  }
}
stop_process Saylane
stop_process RTranslate
# Installer owns the live /Library/Input Methods/Saylane.app upgrade. Legacy and
# user-level duplicates are removed by postinstall only after the new payload is
# present and registered, so a payload failure leaves the previous app intact.
