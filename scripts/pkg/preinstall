#!/bin/bash
set -euo pipefail
export TZ=Asia/Shanghai
# Runs before the new files are written. The live installation is not touched
# here: Installer replaces each bundle atomically, so a failed payload leaves
# the previous version in place.

# The main program is quit so that the one started afterwards is the new
# version. It holds no state that a quit can lose.
MAIN='/Applications/Saylane.app/Contents/MacOS/Saylane'
/usr/bin/pkill -TERM -f "^$MAIN" 2>/dev/null || true
for _ in {1..50}; do
  /usr/bin/pgrep -f "^$MAIN" >/dev/null 2>&1 || break
  /bin/sleep 0.1
done
/usr/bin/pkill -KILL -f "^$MAIN" 2>/dev/null || true

# The input method is deliberately NOT stopped here. macOS counts every exit
# of an input-method process (more than ten in half an hour and every running
# application drops it until relaunched), and a process killed now would be
# started again at once from the old files. postinstall restarts it exactly
# once, after the new files are in place.
