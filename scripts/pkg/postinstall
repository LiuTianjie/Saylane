#!/bin/bash
set -euo pipefail
APP='/Library/Input Methods/Saylane.app'
BIN="$APP/Contents/MacOS/Saylane"
[[ -x "$BIN" ]] || { echo 'Saylane executable is missing' >&2; exit 1; }
# Registration is a machine-install step; user approval/selection is not.
# Do not run an immediate enable/select loop as root or pretend selection succeeded.
"$BIN" --register-input-source
CONSOLE_USER="$(/usr/bin/stat -f '%Su' /dev/console)"
if [[ "$CONSOLE_USER" == root || "$CONSOLE_USER" == loginwindow || -z "$CONSOLE_USER" ]]; then
  echo 'Saylane files installed. Open the app after login to complete input-source activation.'
  exit 0
fi
CONSOLE_UID="$(/usr/bin/id -u "$CONSOLE_USER")"
/bin/launchctl asuser "$CONSOLE_UID" /usr/bin/sudo -H -u "$CONSOLE_USER" \
  /usr/bin/open "$APP" --args --setup
# Installer success means files installed. The app separately verifies activation.
echo 'Saylane installed; the setup app will verify user approval, enablement, and selection.'
